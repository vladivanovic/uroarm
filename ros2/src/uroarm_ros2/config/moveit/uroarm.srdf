<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal hand-written SRDF. Regenerate/verify with moveit_setup_assistant
     during MoveIt bring-up. The arm is 5-DoF for pose, so plan pose goals
     with orientation relaxed (position + pitch), as the analytic IK does. -->
<robot name="uroarm">
    <group name="arm">
        <chain base_link="base_link" tip_link="gripper_link"/>
    </group>
    <group name="gripper">
        <joint name="gripper"/>
    </group>
    <group_state name="ready" group="arm">
        <joint name="shoulder_pan" value="0"/>
        <joint name="shoulder_lift" value="0"/>
        <joint name="elbow_flex" value="-1.5708"/>
        <joint name="wrist_flex" value="-1.5708"/>
        <joint name="wrist_roll" value="0"/>
    </group_state>
    <end_effector name="gripper" parent_link="gripper_link" group="gripper"/>
    <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
    <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
    <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
    <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
    <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
    <disable_collisions link1="link_5" link2="gripper_link" reason="Adjacent"/>
</robot>
