<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uroarm_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 driver, URDF and MoveIt 2 config for the uroarm-derived hobby-servo arms. Joint state is COMMANDED (echo) — the hardware has no position feedback.</description>
  <maintainer email="vlad@vladivanovic.com">Vladimir Ivanovic</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
