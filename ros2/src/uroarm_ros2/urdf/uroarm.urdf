<?xml version="1.0"?>
<!-- uroarm URDF — geometry from arm.yaml (links L0..L4 = 111/105/98/25/157 mm).

     Zero pose: pitch chain pointing straight up (+Z), which matches the
     driver's forward kinematics at joint zero (TCP at x=25, y=0, z=471 mm).
     Joint limits match arm.yaml joint-space limits.

     APPROXIMATION, flagged honestly: link shapes are simple boxes, masses
     are placeholders, and pitch/roll axis SIGNS have not yet been checked
     against the physical arm (the arm's calibration lives in servo space;
     aligning URDF zero/signs with it is a bring-up task). Good enough for
     RViz, TF and MoveIt planning bring-up; verify signs before trusting
     Cartesian moves on hardware. -->
<robot name="uroarm">

  <link name="base_link">
    <visual><geometry><cylinder radius="0.045" length="0.02"/></geometry>
      <origin xyz="0 0 0.01"/></visual>
  </link>

  <!-- shoulder_pan -->
  <link name="link_1">
    <visual><geometry><box size="0.05 0.05 0.111"/></geometry>
      <origin xyz="0 0 0.0555"/></visual>
    <inertial><mass value="0.2"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.02"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.5"/>
  </joint>

  <!-- shoulder_lift -->
  <link name="link_2">
    <visual><geometry><box size="0.04 0.04 0.105"/></geometry>
      <origin xyz="0 0 0.0525"/></visual>
    <inertial><mass value="0.3"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="shoulder_lift" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0 0 0.111"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.5"/>
  </joint>

  <!-- elbow_flex -->
  <link name="link_3">
    <visual><geometry><box size="0.035 0.035 0.098"/></geometry>
      <origin xyz="0 0 0.049"/></visual>
    <inertial><mass value="0.2"/><inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="elbow_flex" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0 0 0.105"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.5"/>
  </joint>

  <!-- wrist_flex -->
  <link name="link_4">
    <visual><geometry><box size="0.03 0.03 0.04"/></geometry>
      <origin xyz="0 0 0.02"/></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="wrist_flex" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0 0 0.098"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.5"/>
  </joint>

  <!-- wrist_roll: origin carries the L3=25mm perpendicular wrist offset -->
  <link name="link_5">
    <visual><geometry><box size="0.025 0.025 0.157"/></geometry>
      <origin xyz="0 0 0.0785"/></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="wrist_roll" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin xyz="0.025 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="5" velocity="1.5"/>
  </joint>

  <!-- gripper -->
  <link name="gripper_link">
    <visual><geometry><box size="0.02 0.05 0.04"/></geometry>
      <origin xyz="0 0 0.02"/></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="gripper" type="revolute">
    <parent link="link_5"/><child link="gripper_link"/>
    <origin xyz="0 0 0.157"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.7453" effort="5" velocity="1.5"/>
  </joint>

  <link name="tool0"/>
  <joint name="tool0_fixed" type="fixed">
    <parent link="gripper_link"/><child link="tool0"/>
    <origin xyz="0 0 0.04"/>
  </joint>

</robot>
